  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Main action.",
      "html": "<button class=\"ds-button-primary\">Start conversation</button>",
      "css": ".ds-button-primary{font-family:\"DM Sans Variable\",sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:9px;border:1px solid var(--line,#dddfe4);border-radius:6px;font-size:13px;font-weight:600;cursor:pointer;transition:background .15s,color .15s,border-color .15s;background:var(--red,#c92d36);color:var(--white,#fff);border-color:var(--red,#c92d36);min-height:46px;padding:12px 22px;}.ds-button-primary:hover:not(:disabled){background:var(--red-hover,#ad2029);border-color:var(--red-hover,#ad2029);}.ds-button-primary:focus-visible{outline:3px solid #778fbe;outline-offset:4px;}.ds-button-primary:disabled{opacity:.45;cursor:not-allowed;}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Secondary conversation control.",
      "html": "<button class=\"ds-button-secondary\">Continue</button>",
      "css": ".ds-button-secondary{font-family:\"DM Sans Variable\",sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:9px;border:1px solid var(--line,#dddfe4);border-radius:6px;font-size:13px;font-weight:600;cursor:pointer;transition:background .15s,color .15s,border-color .15s;background:var(--surface,#fff);color:var(--ink,#182b48);min-height:42px;padding:10px 17px;}.ds-button-secondary:hover:not(:disabled){background:var(--hover-fill,#eceef2);border-color:var(--hover-line,#bfc6d1);}.ds-button-secondary:focus-visible{outline:3px solid #778fbe;outline-offset:4px;}.ds-button-secondary:disabled{opacity:.45;cursor:not-allowed;}"
    },
    {
      "name": "Text action",
      "kind": "button",
      "refersTo": "button-text",
      "description": "Compact inline action.",
      "html": "<button class=\"ds-text\">Create an account</button>",
      "css": ".ds-text{font-family:\"DM Sans Variable\",sans-serif;background:none;border:0;padding:0;color:var(--red-ink,#c92d36);font-size:13px;font-weight:600;cursor:pointer;}.ds-text:hover:not(:disabled){text-decoration:underline;text-underline-offset:4px;}.ds-text:focus-visible{outline:3px solid #778fbe;outline-offset:4px;}.ds-text:disabled{opacity:.45;cursor:not-allowed;}"
    },
    {
      "name": "Icon action",
      "kind": "button",
      "refersTo": "button-icon",
      "description": "Named compact close control.",
      "html": "<button class=\"ds-icon\" aria-label=\"Close room setup\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m6 6 12 12M6 18 18 6\"/></svg></button>",
      "css": ".ds-icon{display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;padding:7px;background:transparent;border:0;border-radius:5px;color:var(--ink,#182b48);cursor:pointer;transition:background .15s;}.ds-icon:hover:not(:disabled){background:#879cb522;}.ds-icon:focus-visible{outline:3px solid #778fbe;outline-offset:4px;}.ds-icon:disabled{opacity:.45;cursor:not-allowed;}"
    },
    {
      "name": "Labeled field",
      "kind": "input",
      "refersTo": "input",
      "description": "Standard surface form field.",
      "html": "<label class=\"ds-label\">Room name<input class=\"ds-field\" placeholder=\"Give your room a name\" /></label>",
      "css": ".ds-label{font-family:\"DM Sans Variable\",sans-serif;display:grid;gap:9px;font-size:13px;font-weight:600;color:var(--ink,#182b48);}.ds-field{font-family:\"DM Sans Variable\",sans-serif;width:100%;border:1px solid var(--field-line,#cdd1d9);border-radius:var(--radius,8px);background:var(--surface,#fff);color:var(--ink,#182b48);padding:12px 14px;caret-color:var(--red,#c92d36);font-size:13px;}.ds-field::placeholder{color:var(--muted,#657084);}.ds-field:focus{outline:2px solid #8197bd;outline-offset:1px;}"
    },
    {
      "name": "Room navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Inverse room rows with an explicit selected state; the rooms heading carries its count and an Archived chats link.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Rooms\"><div class=\"ds-nav-label\"><span>Your rooms</span><span class=\"ds-nav-count\">6</span><button class=\"ds-nav-archive\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect width=\"20\" height=\"5\" x=\"2\" y=\"3\" rx=\"1\"/><path d=\"M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8\"/><path d=\"M10 12h4\"/></svg> Archived chats</button></div><button class=\"ds-room\" aria-current=\"page\">Make room for reading<small>Planning</small></button><button class=\"ds-room\">A little room for ideas<small>Exploration</small></button></nav>",
      "css": ".ds-nav{font-family:\"DM Sans Variable\",sans-serif;background:var(--frame,#122747);padding:17px;width:260px;}.ds-nav-label{display:flex;align-items:center;color:#b1c0d7;font-size:11px;letter-spacing:.045em;text-transform:uppercase;font-weight:600;margin:0 0 8px 10px;}.ds-nav-count{margin:0 auto 0 8px;}.ds-nav-archive{display:inline-flex;align-items:center;gap:6px;min-height:36px;padding:0 8px;border:0;border-radius:6px;background:none;color:#c3cfe0;font:500 12px \"DM Sans Variable\",sans-serif;letter-spacing:0;text-transform:none;cursor:pointer;}.ds-nav-archive:hover{background:#ffffff13;color:#fff;}.ds-room{font-family:\"DM Sans Variable\",sans-serif;display:block;width:100%;text-align:left;padding:13px 12px;border:0;border-radius:6px;background:none;color:#e1e8f2;font-size:12px;cursor:pointer;margin-bottom:5px;}.ds-room small{display:block;font-size:10px;color:#b6c3d7;margin-top:5px;}.ds-room:hover{background:#ffffff0c;}.ds-room[aria-current]{background:#ffffff13;}.ds-room:focus-visible,.ds-nav-archive:focus-visible{outline:3px solid #778fbe;outline-offset:4px;}"
    },
    {
      "name": "Purpose chip",
      "kind": "chip",
      "refersTo": "purpose-chip",
      "description": "Selectable purpose, shown in its selected state.",
      "html": "<button class=\"ds-purpose\" aria-pressed=\"true\">Planning</button>",
      "css": ".ds-purpose{font-family:\"DM Sans Variable\",sans-serif;border:1px solid var(--line,#dddfe4);background:var(--surface,#fff);padding:9px 11px;border-radius:5px;font-size:11px;font-weight:550;color:var(--muted,#657084);cursor:pointer;}.ds-purpose[aria-pressed=\"true\"]{background:var(--select-fill,#122747);border-color:var(--select-fill,#122747);color:var(--white,#fff);}.ds-purpose:hover:not([aria-pressed=\"true\"]){border-color:var(--strong-line,#8797ae);color:var(--ink,#182b48);}.ds-purpose:focus-visible{outline:3px solid #778fbe;outline-offset:4px;}"
    },
