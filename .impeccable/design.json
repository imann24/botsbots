  "narrative": {
    "northStar": "Jet age",
    "overview": "Jet age gives the workspace a confident navy frame, warm paper reading surface, decisive red controls, and tightly organized information. The reference is expressed through proportion, typography, the stepped brand mark, numbered turns, and finite allowance segments; it does not become a physical ticket or travel interface.\n\nThe conversation stays generous while navigation and settings stay compact. Flat surfaces, fine dividers, and small tonal changes establish hierarchy. The same visual language carries into the split authentication screen without adding decorative imagery.",
    "keyCharacteristics": [
      "Navy structure, paper reading space, red actions.",
      "Manrope headings paired with DM Sans interface and conversation text.",
      "Numbered replies and visible finite allowances.",
      "Flat surfaces, restrained corners, and short state changes."
    ],
    "rules": [
      {
        "name": "The Action Color Rule",
        "body": "Use red for primary actions and attention; use carbon purple for measurement and turn markers.",
        "section": "colors"
      },
      {
        "name": "The Reading Rhythm Rule",
        "body": "Keep conversation text at a comfortable line height and bounded measure; compact metadata must remain subordinate.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Separate surfaces with color and fine borders; do not add elevation shadows to the established workspace.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the navy frame, paper canvas, and white controls as the default surface hierarchy.",
      "Do keep allowance counts, budget, and turn numbers visually distinct from conversation prose.",
      "Do carry visible focus, selected states, disabled states, and reduced-motion behavior into new controls.",
      "Do switch compact screens to explicit drawers and preserve independently scrollable content."
    ],
    "donts": [
      "Don't turn the Jet age reference into fake travel controls or a physical ticket costume.",
      "Don't replace the established flat hierarchy with floating shadow cards.",
      "Don't use red for routine measurement or carbon purple for the primary action.",
      "Don't squeeze all three workspace columns into a narrow screen."
    ]
  }
}
