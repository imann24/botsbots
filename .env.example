# Server only. Keep your existing key in .env.local.
AI_GATEWAY_API_KEY=
# pnpm db:start fills these from the local Supabase stack.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Per-account weekly allowances in USD, shared across all rooms and summaries.
# Reset Monday at 00:00 UTC. Blank/unset uses these defaults; 0 blocks new spend.
WEEKLY_BUDGET_USD=10
# One allowance for all premium accounts: "unlimited" or a nonnegative dollar amount.
PREMIUM_WEEKLY_BUDGET_USD=unlimited
# Optional public origin for social metadata. Vercel supplies this automatically.
# Set this to your deployed origin when hosting elsewhere (include https://).
SITE_URL=
# Server-only contact email delivery through Resend.
RESEND_API_KEY=
# Optional overrides; blank/unset uses these addresses.
CONTACT_ADMIN_EMAIL=hello@botsbots.app
CONTACT_FROM_EMAIL=noreply@botsbots.app
